# Copy this file to .env and fill in the authentication settings.
EMBED_MODEL=intfloat/multilingual-e5-small
LLM_MODEL=qwen2.5:3b-instruct
COLLECTION=normative_docs_v2
TORCH_THREADS=4
EMBED_BATCH_SIZE=8

# Required: configure users and bcrypt hashes for Tinyauth v5.
# Use single quotes around the value to preserve literal $ in bcrypt hashes.
TINYAUTH_USERS=''

# Must match the auth hostname in nginx/default.conf, including the port.
TINYAUTH_APP_URL=http://auth.example.test:8000
TINYAUTH_SECURE_COOKIE=false
